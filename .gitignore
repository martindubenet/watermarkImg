# Node
node_modules/

# Source maps (generated by Sass — not needed in production)
public/assets/css/*.map

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editor
# .vscode/ is intentionally committed (not ignored) — tasks.json auto-starts
# `npm run sass:watch` on folder open, settings.json allows it without a
# prompt. This is what makes the sourcemap-on-save workflow portable to a
# new workstation: clone the repo, run `npm install`, open in VS Code, done.
*.swp
*.swo

# PHP logs
*.log
php_errors.log

# Local stamp files (pre-push hook freshness check — see .githooks/pre-push)
.build-stamps/

# Custom file backups
*.backup
Claude outputs/*

# Portfolio source images — only the AVIF versions (generated via
# `npm run images:avif`, see README) are committed. The PNG/JPG originals
# stay local only, in every subfolder of `img/portfolio`.
public/assets/img/portfolio/**/*.png
public/assets/img/portfolio/**/*.jpg
public/assets/img/portfolio/**/*.jpeg
